generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          Role      @default(USER)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  items          Item[]
  bookings       Booking[]
  history_events ItemHistoryEvent[]
  reviews_authored Review[] @relation("ReviewAuthor")
  reviews_received Review[] @relation("ReviewTarget")
  messages       Message[]
}

model Item {
  id                  String   @id @default(uuid())
  owner_id            String
  title               String
  description         String
  category            String
  tags                String[] // generic string array
  serial_number       String?
  price_per_day       Float
  deposit_amount      Float
  condition_checklist Json?
  is_available        Boolean  @default(true)
  
  // Hyperlocal location MVP
  city                String
  area                String
  latitude            Float?
  longitude           Float?
  passport_hash       String?  @unique

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  owner               User               @relation(fields: [owner_id], references: [id])
  bookings            Booking[]
  history_events      ItemHistoryEvent[]
  photos              ItemPhoto[]
}

model ItemPhoto {
  id         String   @id @default(uuid())
  item_id    String
  url        String
  public_id  String
  order      Int      @default(0)
  created_at DateTime @default(now())

  item       Item     @relation(fields: [item_id], references: [id])

  @@index([item_id, order])
}

model Booking {
  id         String   @id @default(uuid())
  item_id    String
  renter_id  String
  start_date DateTime
  end_date   DateTime
  status     String   @default("pending") // pending, accepted, rejected, active, returned, cancelled
  
  terms_accepted_at DateTime?
  terms_version     String?
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  item           Item               @relation(fields: [item_id], references: [id])
  renter         User               @relation(fields: [renter_id], references: [id])
  history_events ItemHistoryEvent[]
  reviews        Review[]
  messages       Message[]
}

model Message {
  id         String   @id @default(uuid())
  booking_id String
  sender_id  String
  body       String
  created_at DateTime @default(now())

  booking    Booking  @relation(fields: [booking_id], references: [id])
  sender     User     @relation(fields: [sender_id], references: [id])

  @@index([booking_id, created_at, id])
}

enum ReviewTargetRole {
  OWNER
  RENTER
}

model Review {
  id           String           @id @default(uuid())
  booking_id   String
  reviewer_id  String
  target_id    String
  target_role  ReviewTargetRole
  rating       Int              // 1 to 5
  comment      String?
  created_at   DateTime         @default(now())

  booking      Booking @relation(fields: [booking_id], references: [id])
  reviewer     User    @relation("ReviewAuthor", fields: [reviewer_id], references: [id])
  target       User    @relation("ReviewTarget", fields: [target_id], references: [id])

  @@unique([booking_id, reviewer_id])
}

enum EventType {
  ITEM_LISTED
  ITEM_UNLISTED
  ITEM_RELISTED
  RENTAL_REQUESTED
  RENTAL_ACCEPTED
  RENTAL_RETURNED
  CONDITION_UPDATED
}

model ItemHistoryEvent {
  id                 String    @id @default(uuid())
  item_id            String
  booking_id         String?
  actor_id           String?
  event_type         EventType
  condition_snapshot Json?
  metadata           Json?
  created_at         DateTime  @default(now())

  item    Item     @relation(fields: [item_id], references: [id])
  booking Booking? @relation(fields: [booking_id], references: [id])
  actor   User?    @relation(fields: [actor_id], references: [id])
}
